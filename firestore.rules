rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all to prevent unmapped collection access
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Secure Helper Primitives
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // Admin override validated securely via verified login emails
    function isAdmin() {
      return isSignedIn() && 
             (request.auth.token.email == 'Waseemkhan2466@gmail.com' || 
              request.auth.token.email == 'waseemkhan2466@gmail.com' || 
              request.auth.token.email == 'admin@wrsmile.com' || 
              exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Entity validation schema checks
    function isValidProduct(data) {
      return data.keys().hasAll(['title', 'slug', 'description', 'price_retail', 'stock', 'category', 'images', 'featured', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 100 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 5000 &&
             data.price_retail is int && data.price_retail >= 0 &&
             data.stock is int && data.stock >= 0 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
             data.images is list && data.images.size() > 0 && data.images.size() <= 10 &&
             data.featured is bool &&
             data.createdAt is string;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['items', 'total', 'customerName', 'customerPhone', 'shippingAddress', 'status', 'createdAt']) &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.total is int && data.total >= 0 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 200 &&
             data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 50 &&
             data.shippingAddress is string && data.shippingAddress.size() > 0 && data.shippingAddress.size() <= 1000 &&
             data.status is string && (data.status == 'pending' || data.status == 'confirmed' || data.status == 'shipped' || data.status == 'delivered') &&
             data.createdAt is string;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.role is string && (data.role == 'customer' || data.role == 'admin');
    }

    // Product collection rule permissions
    match /products/{productId} {
      allow read: if true; // Public catalog access so visitors can browse books/items
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // Order collection rule permissions
    match /orders/{orderId} {
      // Anyone can checkout an order. If user is signed in, enforce match on their own email key if present.
      allow create: if isValidOrder(incoming()) && 
                    (!incoming().keys().hasAll(['userEmail']) || !isSignedIn() || incoming().userEmail == request.auth.token.email);
      
      // Dynamic query enforcers checking resource.data context directly to prevent blanket read scraping
      allow get: if isAdmin() || (isSignedIn() && existing().userEmail == request.auth.token.email);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userEmail == request.auth.token.email);
      
      // Updates strictly restricted to administrators
      allow update: if isAdmin() && isValidOrder(incoming());
      allow delete: if isAdmin();
    }

    // User Profile collection rule permissions
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && userId == request.auth.uid);
      allow create: if (isSignedIn() && userId == request.auth.uid && isValidUser(incoming()) && 
                       (incoming().role == 'customer' || incoming().email == 'admin@wrsmile.com' || incoming().email == 'Waseemkhan2466@gmail.com' || incoming().email == 'waseemkhan2466@gmail.com'));
      allow update: if (isSignedIn() && userId == request.auth.uid && isValidUser(incoming()) && 
                       incoming().role == existing().role); // Cannot escalation-hack own roles
      allow delete: if isAdmin();
    }
  }
}
